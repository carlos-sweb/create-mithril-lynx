# Release signing template.
#
# Copy this file to keystore.properties (gitignored) and fill in the values, or
# just run:
#
#   npm run android:keystore
#
# which generates the .keystore and this file for you.
#
# storeFile resolves against the root of THIS Android project, so
# "release.keystore" means <android-dir>/release.keystore.
storeFile=release.keystore
storePassword=change-me
keyAlias=release
keyPassword=change-me
